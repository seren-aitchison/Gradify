{
  "name": "gradify",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.mjs",
    "eval": "node scripts/eval-notes.mjs",
    "eval:claude": "node scripts/eval-notes.mjs --claude",
    "serve": "python3 -m http.server 8080",
    "build:dashboard": "node scripts/build-dashboard-function.mjs",
    "sync": "node scripts/sync-kit.mjs",
    "preload": "node scripts/preload-modules.mjs",
    "new-site": "node scripts/new-site.mjs",
    "add-3d": "node scripts/add-3d.mjs",
    "qa": "node scripts/qa-courses.mjs && node scripts/qa-content-run.mjs && node scripts/lab-coverage.mjs && node scripts/concept-map.mjs && node scripts/subject-spec-doc.mjs",
    "verify:backend": "node scripts/verify-backend.mjs",
    "audit": "node scripts/audit-sites.mjs",
    "check:sync": "node scripts/check-sync.cjs",
    "supabase:admin": "node scripts/supabase-admin.mjs",
    "check:live": "node scripts/check-live.cjs",
    "check:consent": "node scripts/check-consent.cjs",
    "labs": "node scripts/lab-coverage.mjs",
    "bench": "node scripts/bench.mjs",
    "audit:quality": "node scripts/quality-audit.mjs",
    "constitution": "node -e \"import('./kit/quality/constitution.js').then(m=>require('fs').writeFileSync('department/constitution.txt', m.asText()+'\\n'))\"",
    "seo": "node scripts/build-seo.mjs && node scripts/build-sitemap.mjs && node scripts/seo-audit.mjs",
    "seo:audit": "node scripts/seo-audit.mjs --check"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@electric-sql/pglite": "0.5.15",
    "axe-core": "4.10.3",
    "bcryptjs": "2.4.3",
    "esbuild": "^0.25.0",
    "playwright": "1.63.0",
    "ts-fsrs": "4.7.1"
  }
}
